# Environnement iPhone — copie ce fichier en .env.local pour override local
# NE COMMIT AUCUN SECRET.

# API du Worker Cloudflare (partagée avec la web app)
VITE_API_BASE=https://royaume-api.square-paris75.workers.dev

# Fournisseur analytics : "posthog" | "amplitude" | "none"
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_KEY=

# Niveau de logs : "debug" | "info" | "warn" | "error" | "silent"
VITE_LOG_LEVEL=info

# Feature flags
VITE_FEATURE_DOWNLOAD_PACKS=true
VITE_FEATURE_PARENT_BIOMETRIC=true
