{
  "name": "royaume-savoirs-ios",
  "version": "0.1.0",
  "private": true,
  "description": "Application iPhone offline-first du Royaume des Savoirs. Projet séparé, indépendant de la web app.",
  "scripts": {
    "sync:www": "node scripts/sync-www.mjs",
    "dev": "vite --port 5174",
    "build": "npm run sync:www && vite build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "ios:build": "npm run cap:sync && echo 'Ouvre Xcode via npm run cap:open puis Product > Archive'",
    "verify:web-app-intact": "node scripts/verify-web-app.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capgo/capacitor-native-biometric": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
